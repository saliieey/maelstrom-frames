# ── Important ─────────────────────────────────────────────────────────────
# Next.js does NOT load this file. Copy to ".env.local" and fill in real values.
# File must sit next to package.json. Then restart: npm run dev
# ──────────────────────────────────────────────────────────────────────────

# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_doomvaFG_Kv3XCbVDN4XBhSiXdY7FaQcG

# Where enquiry emails are delivered.
#
# Resend + default sender "onboarding@resend.dev" ONLY allows sending TO the
# same email address you used to sign up for Resend — NOT arbitrary inboxes.
# So either:
#   (A) Set CONTACT_TO_EMAIL to that signup email until you verify a domain, or
#   (B) Verify your domain at https://resend.com/domains (e.g. maelstromglobal.in),
#       set CONTACT_FROM_EMAIL below to an address on that domain, then you can
#       use CONTACT_TO_EMAIL=maelstromframes@gmail.com (or any recipient).
CONTACT_TO_EMAIL=maelstromframes@gmail.com

# After domain verification in Resend (required for real production mail):
# CONTACT_FROM_EMAIL=Maelstrom Frames <noreply@maelstromglobal.in>
